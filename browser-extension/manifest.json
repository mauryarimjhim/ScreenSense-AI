{
  "manifest_version": 3,
  "name": "ScreenSense AI Tracker",
  "version": "1.0.0",
  "description": "Tracks browser activity for ScreenSense AI",
  "permissions": ["tabs", "storage", "alarms", "windows"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dashboard-auth.js"],
    "run_at": "document_start"
  }]
}
