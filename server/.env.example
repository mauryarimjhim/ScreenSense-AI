PORT=5000
# Paste your FULL string from Atlas → Connect → Drivers (replace ALL placeholders)
# Example: mongodb+srv://myuser:mypassword@cluster0.ab12cd.mongodb.net/ScreenSenseAI?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER_HOST.mongodb.net/ScreenSenseAI?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
